{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "about.splash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show splash screen at launch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать заставку при запуске"
          }
        }
      }
    },
    "about.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A toolkit for sound engineers. Function 1: automatic sound system setup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор инструментов звукорежиссёра. Функция 1: автоматическая настройка акустической системы."
          }
        }
      }
    },
    "about.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About SSMT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "action.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
