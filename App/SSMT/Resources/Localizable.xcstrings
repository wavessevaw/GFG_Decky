    "capture.1.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn ON all loudspeakers: subwoofers and mains. This is the \"before\" reference."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите ВСЕ громкоговорители: сабвуферы и топы. Это контрольный замер «до»."
          }
        }
      }
    },
    "capture.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole system"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся система"
          }
        }
      }
    },
    "capture.2.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute the mains (satellites) on the processor. Leave only the subwoofers on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замьютьте сателлиты (топы) на процессоре. Оставьте включёнными только сабвуферы."
          }
        }
      }
    },
    "capture.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subwoofers only"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только сабвуферы"
          }
        }
      }
    },
    "capture.3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmute the mains and mute the subwoofers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите сателлиты и замьютьте сабвуферы."
          }
        }
      }
    },
    "capture.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains only"
          }
        },
