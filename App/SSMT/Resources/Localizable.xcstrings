            "state": "translated",
            "value": "Уровень %.0f dBFS · SNR %.0f dB"
          }
        }
      }
    },
    "autolevel.raising": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising level…"
          }
        },
