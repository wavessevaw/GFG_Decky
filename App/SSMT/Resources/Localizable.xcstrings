    "action.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "STOP"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "STOP"
          }
        }
      }
    },
    "action.stop.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute the test signal immediately (Esc)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенно заглушить тестовый сигнал (Esc)"
          }
        }
      }
    },
    "advice.conditionsChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something changed since the captures (microphone position, processor settings, people in the room). Repeat the setup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С момента замеров что-то изменилось (позиция микрофона, настройки процессора, люди в зале). Повторите настройку."
          }
        }
      }
    },
    "advice.delayNotApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like the delay was not entered. Check the delay on the processor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, задержка не введена. Проверьте задержку в процессоре."
          }
        }
      }
    },
    "advice.delayWrongSign": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The delay seems to be on the wrong group (subs vs mains)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, задержка введена не той группе (сабы ↔ топы)."
          }
        }
      }
    },
    "advice.levelMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The level change seems not to be applied."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, изменение уровня не применено."
          }
        }
      }
    },
    "advice.polarityNotApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like the polarity was not changed. Check the subwoofer polarity on the processor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, полярность не изменена. Проверьте полярность сабвуфера в процессоре."
          }
        }
      }
    },
    "autolevel.clipped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipping — level reduced"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клиппинг — уровень снижен"
          }
        }
      }
    },
    "autolevel.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures room noise, then raises the level until SNR ≥ 20 dB or the maximum level."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замеряет шум помещения, затем поднимает уровень до SNR ≥ 20 dB или до максимального уровня."
          }
        }
      }
    },
    "autolevel.max": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum reached · SNR only %.0f dB"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут максимум · SNR только %.0f dB"
          }
        }
      }
    },
    "autolevel.noise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measuring room noise — keep quiet…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замер шума помещения — тишина…"
          }
        }
      }
    },
    "autolevel.ok": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level %.0f dBFS · SNR %.0f dB"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уровень %.0f dBFS · SNR %.0f dB"
          }
        }
      }
    },
    "autolevel.raising": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raising level…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимаю уровень…"
          }
        }
      }
    },
    "autolevel.run": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto level"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоуровень"
          }
        }
