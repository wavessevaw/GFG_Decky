    "capture.3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmute the mains and mute the subwoofers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите сателлиты и замьютьте сабвуферы."
          }
