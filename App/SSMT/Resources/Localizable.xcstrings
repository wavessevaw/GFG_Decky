    "autolevel.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures room noise, then raises the level until SNR ≥ 20 dB or the maximum level."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замеряет шум помещения, затем поднимает уровень до SNR ≥ 20 dB или до максимального уровня."
          }
        }
      }
    },
    "autolevel.max": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum reached · SNR only %.0f dB"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут максимум · SNR только %.0f dB"
