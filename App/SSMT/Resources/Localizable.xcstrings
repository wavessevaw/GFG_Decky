      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subwoofers arrive late: delay the mains (≈ %.2f m). Fills and delays shift with them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабвуферы приходят позже: задержите топы (≈ %.2f м). Филлы и делеи сместятся вместе с ними."
          }
        }
      }
    },
    "card.delay.none.detail": {
      "extractionState": "manual",
