    "cal.typical.flat.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost no correction. Use the individual calibration file supplied with the microphone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коррекция почти нулевая. Используйте индивидуальный файл калибровки из комплекта микрофона."
          }
        }
      }
    },
    "cal.typical.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model response from published charts, not your sample. Load the individual file if you have one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "АЧХ модели по графикам производителя, а не вашего экземпляра. Есть индивидуальный файл — загрузите его."
          }
        }
      }
    },
    "capture.1.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All loudspeakers on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите все громкоговорители"
          }
        }
      }
    },
    "capture.1.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn ON all loudspeakers: subwoofers and mains. This is the \"before\" reference."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите ВСЕ громкоговорители: сабвуферы и топы. Это контрольный замер «до»."
          }
        }
      }
    },
    "capture.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whole system"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся система"
          }
        }
      }
    },
    "capture.2.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains muted, subs on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Топы — мьют, сабы — включены"
          }
        }
      }
    },
    "capture.2.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute the mains (satellites) on the processor. Leave only the subwoofers on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замьютьте сателлиты (топы) на процессоре. Оставьте включёнными только сабвуферы."
          }
        }
      }
    },
    "capture.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subwoofers only"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только сабвуферы"
          }
        }
      }
    },
    "capture.3.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subs muted, mains on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сабы — мьют, топы — включены"
          }
        }
      }
    },
    "capture.3.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unmute the mains and mute the subwoofers."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите сателлиты и замьютьте сабвуферы."
          }
        }
      }
    },
    "capture.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mains only"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только топы"
          }
        }
      }
    },
    "capture.5.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings entered, everything on"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки введены, всё включено"
          }
        }
      }
    },
    "capture.5.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the settings on the processor, turn ON all loudspeakers and capture again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите настройки в процессор, включите ВСЕ громкоговорители и сделайте замер."
          }
        }
      }
    },
    "capture.5.title": {
      "extractionState": "manual",
      "localizations": {
