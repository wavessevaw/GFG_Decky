    "osc.find.eos": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands use the console's command line: “#” at the end means Enter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды — это командная строка пульта: «#» в конце означает Enter."
          }
        }
      }
    },
    "osc.find.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sure of the address? Open the OSC monitor and send it from the device or its editor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не знаете адрес? Откройте OSC-монитор и отправьте его из устройства или его редактора."
          }
        }
      }
    },
    "osc.find.grandMA3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any command you can type on the console works as text: Go+ Sequence 3, Off Executor 201…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сработает любая команда, которую можно набрать на пульте: Go+ Sequence 3, Off Executor 201…"
          }
        }
      }
    },
    "osc.find.magicQ": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback numbers are the playback faders on the current page."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер плейбека — номер фейдера плейбека на текущей странице."
          }
        }
      }
    },
    "osc.find.qlab": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Start a cue” takes the cue number as shown in QLab."
