    "capture.5.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the settings on the processor, turn ON all loudspeakers and capture again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите настройки в процессор, включите ВСЕ громкоговорители и сделайте замер."
          }
        }
      }
    },
    "capture.5.title": {
