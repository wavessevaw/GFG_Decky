    "cal.typical.flat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nominally flat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номинально ровный"
          }
