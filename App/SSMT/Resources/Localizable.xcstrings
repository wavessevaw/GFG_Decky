    "cal.calibrator.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the calibrator on the microphone; the test signal is switched off."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наденьте калибратор на микрофон; тестовый сигнал будет выключен."
          }
        }
      }
    },
    "cal.cardioid.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardioid: in a room the top end reads lower than on axis. Point it at the system; for EQ an omni measurement mic is more honest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кардиоида: в зале верх читается ниже, чем на оси. Направьте на систему; для EQ честнее всенаправленный измерительный микрофон."
          }
        }
      }
    },
    "cal.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
