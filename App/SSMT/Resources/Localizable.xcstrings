    "prep.fastMode.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast mode derives the mains from \"whole system − subs\". Less accurate near dips; nothing in the system may change between captures."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрый режим вычисляет топы как «вся система − сабы». Менее точно около провалов; между замерами в системе ничего не должно меняться."
          }
        }
      }
    },
    "prep.hasSub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system has subwoofers"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В системе есть сабвуферы"
          }
        }
      }
    },
    "prep.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the measurement microphone at the main listening position, at ear height, pointing at the system. Start the audio, run auto level (5 s of silence, then a slow rise) and find the delay with all loudspeakers on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставьте измерительный микрофон в основную точку прослушивания на высоте ушей, направив на систему. Запустите аудио, затем автоуровень (5 с тишины, потом плавный подъём) и найдите задержку при включённых громкоговорителях."
          }
        }
      }
    },
    "prep.knownCrossover": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I know the crossover frequency"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я знаю частоту раздела"
          }
        }
      }
