            "value": "Keep quiet for 5 s, then the noise rises slowly to a safe working level."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "5 с тишины, затем шум плавно поднимется до безопасного рабочего уровня."
          }
        }
