{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "about.splash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show splash screen at launch"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать заставку при запуске"
          }
        }
      }
    },
    "about.text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A toolkit for sound engineers. Function 1: automatic sound system setup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Набор инструментов звукорежиссёра. Функция 1: автоматическая настройка акустической системы."
          }
        }
      }
    },
    "about.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About SSMT"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О программе"
          }
        }
      }
    },
    "action.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "action.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "STOP"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "STOP"
          }
        }
      }
    },
    "action.stop.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute the test signal immediately (Esc)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенно заглушить тестовый сигнал (Esc)"
          }
        }
      }
    },
    "advice.conditionsChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something changed since the captures (microphone position, processor settings, people in the room). Repeat the setup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С момента замеров что-то изменилось (позиция микрофона, настройки процессора, люди в зале). Повторите настройку."
          }
        }
      }
    },
    "advice.delayNotApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like the delay was not entered. Check the delay on the processor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, задержка не введена. Проверьте задержку в процессоре."
          }
        }
      }
    },
    "advice.delayWrongSign": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The delay seems to be on the wrong group (subs vs mains)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, задержка введена не той группе (сабы ↔ топы)."
          }
        }
      }
    },
    "advice.levelMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The level change seems not to be applied."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, изменение уровня не применено."
          }
        }
      }
    },
    "advice.polarityNotApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks like the polarity was not changed. Check the subwoofer polarity on the processor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, полярность не изменена. Проверьте полярность сабвуфера в процессоре."
          }
        }
      }
    },
    "app.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SoundSolution Multi Tool"
          }
        },
