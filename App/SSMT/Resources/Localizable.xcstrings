      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typical curve ±2–3 dB"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Типовая кривая ±2–3 дБ"
          }
